		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>card to review</string>
			<key>other</key>
			<string>cards to review</string>
		</dict>
	</dict>
	<key>unit: %lld days</key>
