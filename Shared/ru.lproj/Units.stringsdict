<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Not quite: fix the red %lld letters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Не совсем: исправь красную букву</string>
			<key>few</key>
			<string>Не совсем: исправь красные буквы</string>
			<key>many</key>
			<string>Не совсем: исправь красные буквы</string>
			<key>other</key>
			<string>Не совсем: исправь красные буквы</string>
		</dict>
	</dict>
	<key>unit: %lld cards to review</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>карточка на повторение</string>
			<key>few</key>
			<string>карточки на повторение</string>
			<key>many</key>
			<string>карточек на повторение</string>
			<key>other</key>
			<string>карточки на повторение</string>
		</dict>
	</dict>
	<key>unit: %lld days</key>
