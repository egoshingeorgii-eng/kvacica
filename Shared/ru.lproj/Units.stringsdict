	</dict>
	<key>unit: %lld words learned</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>слова выучено</string>
			<key>few</key>
			<string>слов выучено</string>
			<key>many</key>
			<string>слов выучено</string>
			<key>other</key>
			<string>слов выучено</string>
		</dict>
	</dict>
	<key>unit: %lld words to review</key>
